{
  "datasets": [
    {
      "name": "67dd412d",
      "displayName": "Earthquake_dashboard",
      "queryLines": [
        "Select * from silver.earthquake_data_final"
      ],
      "catalog": "project1_dev",
      "schema": "default"
    },
    {
      "name": "79b561ec",
      "displayName": "Earthquake Magnitude Frequency Classification Summary",
      "queryLines": [
        "SELECT COUNT(*) AS total_magnitude_count,\r\n",
        "magnitude_bucket from (select CASE\r\n",
        "    WHEN mag <2 THEN 'Micro'\r\n",
        "    WHEN mag BETWEEN 2 AND 3 THEN 'Very Minor'\r\n",
        "    WHEN mag BETWEEN 3 AND 4 THEN 'Minor'\r\n",
        "    WHEN mag BETWEEN 4 AND 5 THEN 'Light'\r\n",
        "    WHEN mag BETWEEN 5 AND 6 THEN 'Moderate'\r\n",
        "    WHEN mag BETWEEN 6 AND 7 THEN 'Strong'\r\n",
        "    WHEN mag BETWEEN 7 AND 8 THEN 'Major'\r\n",
        "    WHEN mag BETWEEN 8 AND 10 THEN 'Great'\r\n",
        "    WHEN mag > 10 THEN 'Meteoric'\r\n",
        "    ELSE 'Unknown'\r\n",
        "    END as magnitude_bucket\r\n",
        "    from silver.earthquake_data_final) \r\n",
        " GROUP BY magnitude_bucket\r\n",
        " ORDER BY total_magnitude_count DESC"
      ],
      "catalog": "project1_dev",
      "schema": "default"
    },
    {
      "name": "4cde62b1",
      "displayName": "Eaerthquake_countrywise",
      "queryLines": [
        "SELECT \r\n",
        "COUNT(*) AS EVENT_COUNT,\r\n",
        "case \r\n",
        " WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0]\r\n",
        " ELSE split(place, ', ')[1] \r\n",
        " end as COUNTRY\r\n",
        "FROM (\r\n",
        "    SELECT\r\n",
        "    TIME,\r\n",
        "    TITLE,\r\n",
        "    MAG,\r\n",
        "    LONGITUDE,\r\n",
        "    PLACE,\r\n",
        "    LATITUDE\r\n",
        " FROM silver.earthquake_data_final\r\n",
        ")\r\n",
        "GROUP BY COUNTRY"
      ],
      "catalog": "project1_dev",
      "schema": "default"
    }
  ],
